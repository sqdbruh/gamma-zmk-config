CONFIG_ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS=2
CONFIG_ZMK_KEYBOARD_NAME="Gamma"
CONFIG_PWM=y

# Essentials
CONFIG_PM_DEVICE=y
CONFIG_ARM_MPU=y
CONFIG_PINCTRL=y
CONFIG_GPIO=y
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y
CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y
CONFIG_ZMK_BLE=y
CONFIG_ZMK_USB=y

# Split / sleep
CONFIG_ZMK_SPLIT=y
# Permanent USB connection — keep board awake.
CONFIG_ZMK_SLEEP=n
CONFIG_BT_CTLR_TX_PWR_PLUS_8=y

# Accept fast conn interval requests from the halves and stay on
# 1 Mbps PHY for range. See gamma_left_defconfig for the rationale.
CONFIG_BT_GAP_AUTO_UPDATE_CONN_PARAMS=y
CONFIG_BT_CTLR_PHY_2M=n

# ZMK Studio — live keymap editing via USB.
# The studio-rpc-usb-uart snippet (passed via -S in build.bat / snippet:
# in build.yaml) wires up the CDC-ACM endpoint Studio talks to.
CONFIG_ZMK_STUDIO=y
# Disable Studio locking. Default behaviour requires &studio_unlock
# bound somewhere in the keymap to confirm physical access before
# editing. Off until we wire the unlock behavior into a combo.
CONFIG_ZMK_STUDIO_LOCKING=n

# Clock — nRF52 BLE controller requires an LF clock source.
# nice_nano_v2 has an external 32.768 kHz crystal, so prefer XTAL for
# better BLE timing accuracy and lower current at idle.
CONFIG_CLOCK_CONTROL=y
CONFIG_CLOCK_CONTROL_NRF=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_XTAL=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=n
