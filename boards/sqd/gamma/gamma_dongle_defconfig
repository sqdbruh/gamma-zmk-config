# SPDX-License-Identifier: MIT

CONFIG_ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS=2
CONFIG_ZMK_KEYBOARD_NAME="Gamma"
CONFIG_PWM=y

# ESSENTIALS
CONFIG_PM_DEVICE=y
CONFIG_ARM_MPU=y
CONFIG_PINCTRL=y
CONFIG_GPIO=y
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y
CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y
CONFIG_ZMK_BLE=y
CONFIG_ZMK_USB=y

# OPTIONAL
CONFIG_ZMK_SPLIT=y
# Permanent USB connection — keep board awake.
CONFIG_ZMK_SLEEP=n
CONFIG_BT_CTLR_TX_PWR_PLUS_8=y

# nRF52 LF clock — required for BLE controller to come up. Without one of
# these the BLE init either hangs or panics during SYS_INIT, which is the
# classic "reboot loop before USB enumerates" symptom.
CONFIG_CLOCK_CONTROL=y
CONFIG_CLOCK_CONTROL_NRF=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_XTAL=n

# --- DEBUG ---
# 1) USB CDC ACM logging — open the dongle's COM port at 115200 8N1.
#    Only works once USB enumerates; useless if the crash is pre-USB.
CONFIG_ZMK_USB_LOGGING=y
CONFIG_ZMK_LOG_LEVEL_DBG=y
CONFIG_LOG_MODE_DEFERRED=y
CONFIG_LOG_BUFFER_SIZE=8192
CONFIG_DEBUG_THREAD_INFO=y
CONFIG_THREAD_NAME=y

# 2) SEGGER RTT logging — works over SWD without USB enumeration.
#    Read with: JLinkRTTViewer (free), or `nrfjprog --rtt`, or the
#    Black Magic Probe's `monitor rtt` command in gdb.
#    Both backends run; RTT receives the same log messages as USB CDC.
CONFIG_USE_SEGGER_RTT=y
CONFIG_LOG_BACKEND_RTT=y
CONFIG_LOG_BACKEND_RTT_MODE_BLOCK=y
CONFIG_SEGGER_RTT_BUFFER_SIZE_UP=4096
