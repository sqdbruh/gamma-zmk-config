# SPDX-License-Identifier: MIT

CONFIG_ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS=2
CONFIG_ZMK_KEYBOARD_NAME="Gamma"
CONFIG_PWM=y

# ESSENTIALS
CONFIG_PM_DEVICE=y
CONFIG_ARM_MPU=y
CONFIG_PINCTRL=y
CONFIG_GPIO=y
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y
CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y
CONFIG_ZMK_BLE=y
CONFIG_ZMK_USB=y

# OPTIONAL
CONFIG_ZMK_SPLIT=y
# Permanent USB connection — keep board awake.
CONFIG_ZMK_SLEEP=n
CONFIG_BT_CTLR_TX_PWR_PLUS_8=y

# --- DEBUG: USB CDC ACM logging ---
# Stream LOG_INF/LOG_ERR over a USB serial endpoint. Open the COM port
# the dongle enumerates as (115200 8N1) to read crash output.
CONFIG_ZMK_USB_LOGGING=y
CONFIG_ZMK_LOG_LEVEL_DBG=y
# Deferred mode keeps logs flowing even from ISR / panic context.
CONFIG_LOG_MODE_DEFERRED=y
CONFIG_LOG_BUFFER_SIZE=8192
# Print thread info on a fault before resetting.
CONFIG_DEBUG_THREAD_INFO=y
CONFIG_THREAD_NAME=y
