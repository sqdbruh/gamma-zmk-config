# SPDX-License-Identifier: MIT

CONFIG_ZMK_KEYBOARD_NAME="Gamma"
CONFIG_ZMK_CHECK_BATTERY_BEH=y

# Essentials
CONFIG_PM_DEVICE=y
CONFIG_ARM_MPU=y
CONFIG_PINCTRL=y
CONFIG_GPIO=y
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y
CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y
CONFIG_ZMK_BLE=y

# Split / sleep
CONFIG_ZMK_SPLIT=y
CONFIG_ZMK_SLEEP=n
CONFIG_BT_CTLR_TX_PWR_PLUS_8=y

# ZMK Studio — peripherals participate so Studio can edit per-half
# bindings via the BLE split link to the central.
CONFIG_ZMK_STUDIO=y

# Battery
CONFIG_ZMK_BATTERY_REPORTING=y
CONFIG_ZMK_BATTERY_REPORT_INTERVAL=60
CONFIG_BT_BAS=y

# Clock — nRF52 BLE controller requires an LF clock source.
CONFIG_CLOCK_CONTROL=y
CONFIG_CLOCK_CONTROL_NRF=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_XTAL=n

# Onboard WS2812 strip + SPI bus (driver auto-selects on DT compat).
CONFIG_LED_STRIP=y
CONFIG_SPI=y

# I2C / sensors
CONFIG_I2C=y
CONFIG_SENSOR=y
